{
    "name": "hubbee/wp-plugin",
    "description": "Hubbee WordPress plugin — backend dev tooling.",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Hubbee\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hubbee\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit"
    },
    "config": {
        "sort-packages": true
    }
}
