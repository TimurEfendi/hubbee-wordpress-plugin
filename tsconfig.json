{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@hubbee-shared/*": ["../src/lib/*"],
      "@hubbee-saas/*": ["../src/*"],
      "@/*": ["../src/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "vite.elements.config.ts", "vite.backgrounds.config.ts", "vite.textfx.config.ts"],
  "exclude": ["node_modules", "dist", "assets"]
}
